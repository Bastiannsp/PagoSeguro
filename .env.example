# Copia este archivo como .env y cambia ambos secretos antes de iniciar.
API_KEY=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA
POSTGRES_DB=pagoseguro
POSTGRES_USER=pagoseguro_app
POSTGRES_PASSWORD=REEMPLAZAR_POR_PASSWORD_ALEATORIA
KAFKA_TOPIC=pagoseguro.transaction.predicted
LOG_LEVEL=INFO
RATE_LIMIT=60/minute

# SageMaker: mantener false mientras se use el modelo local.
USE_SAGEMAKER_ENDPOINT=false
SAGEMAKER_ENDPOINT_NAME=
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# Credenciales temporales AWS Academy (no subir .env a GitHub).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
